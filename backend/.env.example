PORT=5001
NODE_ENV=development
LOYALTY_REDEMPTION_ENABLED=true
# Option 1: local MongoDB
MONGODB_URI=mongodb://localhost:27017/nodejs

# Option 2: MongoDB Atlas
# MONGODB_TARGET=atlas
# MONGODB_ATLAS_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Optional if MONGODB_URI is not set: local or atlas
MONGODB_TARGET=local
JWT_SECRET=<generate-a-long-random-secret>
TICKET_QR_ENCRYPTION_SECRET=<generate-a-separate-long-random-secret>
TICKET_CHECKIN_BEFORE_MINUTES=30
TICKET_CHECKIN_AFTER_MINUTES=30
TICKET_QR_RATE_LIMIT_WINDOW_MS=60000
TICKET_QR_RATE_LIMIT_MAX=60
JSON_BODY_LIMIT=1mb
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173
STAFF_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
VNP_TMN_CODE=<your-vnpay-tmn-code>
VNP_HASH_SECRET=<your-vnpay-hash-secret>
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5173/payment/vnpay-return
SEPAY_WEBHOOK_SECRET=<your-sepay-banking-webhook-secret>
SEPAY_API_TOKEN=<your-sepay-api-token>
SEPAY_PG_ENV=sandbox
SEPAY_PG_MERCHANT_ID=<your-sepay-pg-merchant-id>
SEPAY_PG_SECRET_KEY=<your-sepay-pg-secret-key>
# Set this to the SECRET_KEY configured on the SePay Payment Gateway IPN page.
SEPAY_PG_IPN_SECRET=<your-sepay-pg-ipn-secret>

# Email verification / password recovery (Resend, verified sender domain)
RESEND_API_KEY=
EMAIL_FROM="AuraCinema <no-reply@example.com>"
