PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/AuraCinema?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_jwt_secret
TICKET_QR_ENCRYPTION_SECRET=replace_with_a_long_random_ticket_qr_secret
TICKET_CHECKIN_BEFORE_MINUTES=30
TICKET_CHECKIN_AFTER_MINUTES=30
TICKET_QR_RATE_LIMIT_WINDOW_MS=60000
TICKET_QR_RATE_LIMIT_MAX=60
JSON_BODY_LIMIT=1mb
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
VNP_TMN_CODE=<sandbox_tmn_code>
VNP_HASH_SECRET=<sandbox_hash_secret>
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5173/payment/vnpay-return
SEPAY_WEBHOOK_SECRET=your_sepay_webhook_secret
SEPAY_API_TOKEN=your_sepay_api_token
SEPAY_PG_ENV=sandbox
SEPAY_PG_MERCHANT_ID=your_sepay_pg_merchant_id
SEPAY_PG_SECRET_KEY=your_sepay_pg_secret_key
